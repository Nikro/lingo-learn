      "type": "exercise",
      "question": "What does 'currículum vitae' mean in English?",
      "options": ["Curriculum", "CV / resume", "Study plan", "Course schedule"],
      "correct": 1,
      "explanation": "'Currículum vitae' (often abbreviated as CV) = 'resume' — a document summarizing your work experience and qualifications."
    },
    {
      "type": "exercise",
      "question": "What does 'contrato indefinido' mean?",
      "options": ["Temporary contract", "Permanent contract", "Trial contract", "Part-time contract"],
      "correct": 1,
      "explanation": "'Contrato indefinido' = permanent contract — no fixed end date, as opposed to 'contrato temporal' (temporary contract)."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'Acabo de enviar mi ____ para el puesto de analista.' (I just sent my application for the analyst position.)",
      "correct": "candidatura",
      "explanation": "'Candidatura' = job application. 'Enviar mi candidatura' = to send my application."
    },
    {
      "type": "exercise",
      "question": "What does 'periodo de prueba' mean?",
      "options": ["Trial period / probationary period", "Testing time", "Evaluation period", "Training period"],
      "correct": 0,
      "explanation": "'Periodo de prueba' = probationary period — the initial period of employment where both parties evaluate the fit."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: '____ (Sincerely), [Nombre]' — formal closing in a professional email.",
      "correct": "Atentamente",
