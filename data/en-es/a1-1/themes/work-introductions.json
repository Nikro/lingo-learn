  "grammar": [
    {
      "title": "Trabajar & Estar en (to work, to be at)",
      "content": "Trabajar is a regular -ar verb. Estar is used for location and temporary states.\n\nTrabajar: yo trabajo, t\u00fa trabajas, \u00e9l trabaja...\nEstar: yo estoy, t\u00fa est\u00e1s, \u00e9l est\u00e1...\n\nUse 'en' with estar for location: estar en la oficina",
      "examples": [
        "Trabajo en una empresa de tecnolog\u00eda. (I work at a tech company.)",
        "Estoy en la oficina. (I am at the office.)",
        "Mi jefe es simp\u00e1tico. (My boss is nice.)"
      ]
    }
  ],
  "exercises": [
    {
      "type": "multiple-choice",
      "question": "What does 'empresa' mean?",
      "options": [
        "Office",
        "Project",
        "Company",
