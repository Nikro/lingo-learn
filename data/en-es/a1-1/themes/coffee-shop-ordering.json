  "grammar": [
    {
      "title": "Singular & Plural Nouns",
      "content": "Most nouns form the plural by adding -s (if ending in a vowel) or -es (if ending in a consonant).\n\nSingular: el caf\u00e9 \u2192 Plural: los caf\u00e9s\nSingular: el pan \u2192 Plural: los panes\n\nArticles: el/la (the), un/una (a)",
      "examples": [
        "Un caf\u00e9, por favor. (A coffee, please.)",
        "Dos caf\u00e9s, por favor. (Two coffees, please.)",
        "La cuenta, por favor. (The bill, please.)"
      ]
    }
  ],
