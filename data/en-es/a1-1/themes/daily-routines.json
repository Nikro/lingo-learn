  "grammar": [
    {
      "title": "Reflexive Verbs - Daily Actions",
      "content": "Reflexive verbs indicate the subject does the action to themselves. They use reflexive pronouns.\n\nPronouns: me, te, se, nos, os, se\n\nExample: despertarse (to wake up)\n- Me despierto (I wake up)\n- Te despiertas (You wake up)\n- Se despierta (He/she wakes up)",
      "examples": [
        "Me despierto a las siete. (I wake up at seven.)",
        "Ella se ducha por la ma\u00f1ana. (She showers in the morning.)",
        "Nos levantamos tarde. (We get up late.)"
      ]
    }
  ],
  "exercises": [
    {
      "type": "multiple-choice",
      "question": "What does 'despertarse' mean?",
      "options": [
        "To sleep",
        "To wake up",
        "To eat",
        "To go"
      ],
      "correct": 1,
      "explanation": "'Despertarse' is a reflexive verb meaning to wake up."
