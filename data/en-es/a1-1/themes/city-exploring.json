  "grammar": [
    {
      "title": "Hay (There is/are) & Prepositions",
      "content": "Use 'hay' to say there is/there are. It doesn't change.\n\nHay un parque. (There is a park.)\nHay muchas tiendas. (There are many shops.)\n\nPrepositions: en (in), cerca de (near), lejos de (far from), al lado de (next to)",
      "examples": [
        "Hay un hotel cerca. (There is a hotel nearby.)",
        "\u00bfD\u00f3nde est\u00e1 el parque? (Where is the park?)",
        "Est\u00e1 al lado de la iglesia. (It's next to the church.)"
      ]
    }
  ],
  "exercises": [
    {
      "type": "multiple-choice",
      "question": "What does 'hay' mean?",
      "options": [
        "Go to",
        "There is/are",
        "I see",
        "It is"
      ],
      "correct": 1,
      "explanation": "'Hay' means there is or there are."
