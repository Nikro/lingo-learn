  "grammar": [
    {
      "title": "Necesitar & Poder (to need, to be able to)",
      "content": "Necesitar (to need) and poder (to be able to) are regular -ar and -er verbs.\n\nNecesitar: yo necesito, t\u00fa necesitas, \u00e9l necesita...\nPoder: yo puedo, t\u00fa puedes, \u00e9l puede... (stem-changing o\u2192ue)",
      "examples": [
        "Necesito un taxi. (I need a taxi.)",
        "\u00bfPuedo reservar una habitaci\u00f3n? (Can I book a room?)",
        "No entiendo. (I don't understand.)"
      ]
    }
  ],
  "exercises": [
    {
      "type": "multiple-choice",
      "question": "What does 'no entiendo' mean?",
      "options": [
        "I don't like",
        "I don't understand",
        "I don't know",
        "I don't want"
      ],
      "correct": 1,
      "explanation": "'No entiendo' means I don't understand."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: '___ reservar una habitaci\u00f3n.' (I need to book a room.)",
      "correct": "Necesito",
      "explanation": "'Necesitar' conjugated for 'yo': necesito."
    }
  ]
