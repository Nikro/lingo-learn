  "grammar": [
    {
      "title": "Gender Agreement: Adjectives Match Nouns",
      "content": "In Spanish, adjectives change to match the gender of the noun they describe.\n\nMasculine: -o (el libro rojo)\nFeminine: -a (la casa roja)\nInvariable: -e (el coche verde / la mesa verde)\n\nPlural: add -s or -es (rojos, rojas)",
      "examples": [
        "El coche es rojo. (The car is red.)",
        "La casa es blanca. (The house is white.)",
        "Los libros son verdes. (The books are green.)"
      ]
    }
  ],
