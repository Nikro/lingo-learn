  "exercises": [
    {
      "type": "exercise",
      "question": "Choose the correct mood: 'Dudo que ella ____ (venir) mañana.'",
      "options": [
        "viene",
        "venga",
        "viniera",
        "vendrá"
      ],
      "correct": 1,
      "explanation": "'Dudo que' (I doubt that) triggers the subjunctive. 'Venga' is the present subjunctive of venir."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete with the correct mood (indicative or subjunctive): 'Creo que ella ____ (venir) mañana.'",
      "correct": "viene",
      "explanation": "'Creo que' (I believe that) expresses certainty, so it takes the indicative: 'viene'."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'Es importante que tú ____ (estudiar) más.'",
      "correct": "estudies",
      "explanation": "'Es importante que' triggers subjunctive. 'Estudies' = present subjunctive of estudiar."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'No creo que ellos ____ (saber) la verdad.'",
      "correct": "sepan",
      "explanation": "'No creo que' triggers subjunctive. 'Sepan' = present subjunctive of saber."
    },
    {
      "type": "exercise",
      "question": "Choose the correct sentence (subjunctive vs indicative):",
