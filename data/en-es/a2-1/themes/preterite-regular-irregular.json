  "grammar": [
    {
      "title": "Regular Preterite Conjugations",
      "content": "Regular preterite forms:\n\n-AR verbs: -e, -aste, -o, -amos, -asteis, -aron\n\nHablar:\nHablE (I spoke)\nHablamos (We spoke)\n\n-er/-IR verbs: -i, -iste, -io, -imos, -isteis, -ieron\n\nComer:\nComI (I ate)\nComiste (You ate)\nComIO (He/She ate)\nComimos (We ate)\nComisteis (You all ate)\nComieron (They ate)",
      "examples": [
        "Ayer hable con Maria. (Yesterday I spoke with Maria.)",
        "La semana pasada comi en ese restaurante. (Last week I ate at that restaurant.)",
        "Ellos vivieron en Barcelona por dos anos. (They lived in Barcelona for two years.)"
      ]
    },
    {
      "title": "Irregular Preterite Verbs",
      "content": "Irregular preterite verbs (no accent marks on endings):\n\nSer/Ir: fui, fuiste, fue, fuimos, fuisteis, fueron\n\nTener: tube, tuviste, tuvo, tuvimos, tuvisteis, tuvieron\n\nHacer: hice, hiciste, hizo, hicimos, hicisteis, hicieron\n\nVenir: vine, viniste, vino, vinimos, vinisteis, vinieron\n\nPoder: pude, pudiste, pudo, pudimos, pudisteis, pudieron\n\nQuerer: quise, quisiste, quiso, quisimos, quisisteis, quisieron\n\nSaber: supe, supiste, supo, supimos, supisteis, supieron\n\nDecir: dije, dijiste, dijo, dijimos, dijisteis, dijeron",
      "examples": [
        "Fui al cine ayer. (I went to the cinema yesterday.)",
        "Tuve un buen dia. (I had a good day.)",
        "Hice la tarea. (I did the homework.)",
        "Vino a la fiesta. (He/She came to the party.)"
      ]
    },
    {
      "title": "Uses of Preterite",
      "content": "When to use preterite:\n\n1. COMPLETED actions in the past:\nAyer compre un libro. (Yesterday I bought a book.)\n\n2. Specific NUMBER of times:\nTe llame tres veces. (I called you three times.)\n\n3. BEGINNING or END of action:\nEmpezo a llover. (It started to rain.)\nTermino el examen. (He finished the exam.)\n\n4. Sequence of completed actions:\nMe leve, me duche, vesti y sali. (I got up, showered, got dressed and left.)\n\n5. Specific time or date:\nNaci en 1995. (I was born in 1995.)",
      "examples": [
        "Ayer compre un libro nuevo. (Yesterday I bought a new book.)",
        "La semana pasada visite a mis padres. (Last week I visited my parents.)",
        "Naci en Madrid en 1990. (I was born in Madrid in 1990.)",
        "Primero llegue, despues comi, luego me fui. (First I arrived, then I ate, later I left.)"
      ]
    }
  ],
  "pronunciation": [
    {
      "title": "Preterite Pronunciation",
      "content": "Regular preterite endings:\n\n-AR: -e (eh), -aste (ahs-teh), -o (oh), -amos (ah-mohs), -asteis (ahs-tays), -aron (ah-rohn)\n\n-er/-IR: -i (ee), -iste (ees-teh), -io (ee-oh), -imos (ee-mohs), -isteis (ees-tays), -ieron (ee-eh-rohn)\n\nIrregulars (all without accents):\n\nfui (fwee)\nfue (fweh)\ntube (toobeh)\nhice (eeseh)\nvine (veeneh)\ndije (deehmeh)",
      "examples": [
        "hable = ah-BLEH (sounds like 'bleh')\ncomi = koh-MEE (sounds like 'me')",
        "fue = fweh (like 'foo-eh')\ntube = TOO-beh (sounds like 'toob')",
        "vine = BEE-neh\ndije = DEE-heh"
      ]
    }
  ],
  "exercises": [
    {
      "type": "multiple-choice",
      "question": "What is the preterite of 'hablar' for 'yo'?",
      "options": [
        "hablaba",
        "hablE",
        "hablo",
        "hablare"
      ],
      "correct": 1,
      "explanation": "Preterite yo of hablar is 'hablE' (accent on E). Imperfect would be 'hablaba'."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'Ayer ___ al supermercado. (Yesterday I went to the supermarket.)'",
      "correct": "fui",
      "explanation": "Fui = I went (preterite of ir). This is the same as ser in preterite."
    },
    {
      "type": "multiple-choice",
      "question": "Which is the preterite of 'tener'?",
      "options": [
        "tenia",
        "tengo",
        "tube",
        "tendre"
      ],
      "correct": 2,
      "explanation": "Tube = I had (preterite). Tenia = I had (imperfect). Tengo = I have (present)."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'La semana pasada ___ la tarea. (Last week I did the homework.)'",
      "correct": "hice",
      "explanation": "Hice = I did (preterite of hacer). 'La semana pasada' indicates a completed past action."
    },
    {
      "type": "multiple-choice",
      "question": "Which is correct for 'They lived in Madrid'?",
      "options": [
        "Ellos vivian en Madrid",
        "Ellos vivieron en Madrid",
        "Ellos vivir en Madrid",
        "Ellos viven en Madrid"
      ],
      "correct": 1,
      "explanation": "Vivieron = they lived (preterite). Vivian = they lived (imperfect)."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: '___ tres libros la semana pasada. (I bought three books last week.)'",
      "correct": "Compre",
      "explanation": "Compre = I bought (preterite of comprar). Preterite is used for specific number of items."
    },
    {
      "type": "multiple-choice",
      "question": "What is the preterite of 'ser' for 'ella'?",
      "options": [
        "era",
        "fue",
        "es",
        "sera"
      ],
      "correct": 1,
      "explanation": "Fue = she/he was (preterite of ser). Era = was (imperfect)."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'Yo le ___ la verdad. (I told her the truth.)'",
      "correct": "dije",
      "explanation": "Dije = I said/told (preterite of decir). Note the 'j' in the stem."
    },
    {
      "type": "multiple-choice",
      "question": "Which is correct: 'I came, I saw, I conquered'?",
      "options": [
        "Vine, via, venci",
        "Venia, veia,vencia",
        "Vine, vi, venci",
        "Vengo, veo, venzo"
      ],
      "correct": 2,
      "explanation": "Vine, vi, venci = I came, I saw, I conquered (famous Caesar quote). Preterite throughout."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'Cuando ___ tu? (When were you born?)'",
      "correct": "naciste",
      "explanation": "Naciste = you were born (preterite of nacer). 'Cuando naciste' = When were you born?"
    }
  ]
}
