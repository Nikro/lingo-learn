  "grammar": [
    {
      "title": "Reflexive Verbs in the Imperfect (Daily Routines in the Past)",
      "content": "Combine reflexive pronouns (me, te, se, nos, os, se) with imperfect conjugations to describe past daily routines. Reflexive pronouns stay BEFORE the conjugated verb (or attached to the infinitive when using a compound verb form).\n\nReflexive pronouns:\n- me (myself)\n- te (yourself, informal)\n- se (himself/herself/itself/yourselves formal)\n- nos (ourselves)\n- os (yourselves, Spain informal)\n- se (themselves/yourselves formal)",
      "table": {
        "headers": ["Pronoun", "Despertarse", "Levantarse", "Ducharse"],
        "rows": [
          ["yo", "me despertaba", "me levantaba", "me duchaba"],
          ["tú", "te despertabas", "te levantabas", "te duchabas"],
          ["él/ella/usted", "se despertaba", "se levantaba", "se duchaba"],
          ["nosotros", "nos despertábamos", "nos levantábamos", "nos duchábamos"],
          ["vosotros", "os despertabais", "os levantabais", "os duchabais"],
          ["ellos/ellas/ustedes", "se despertaban", "se levantaban", "se duchaban"]
        ]
      },
      "examples": [
        "Me despertaba a las seis de la mañana todos los días. (I used to wake up at six every day.)",
        "Ellos se duchaban después de entrenar. (They used to shower after training.)",
        "Nosotros nos acostábamos tarde los fines de semana. (We used to go to bed late on weekends.)",
        "¿Te afeitabas por la mañana o por la noche? (Did you shave in the morning or at night?)"
      ],
      "aid_note": "Romanian reflexive verbs also use pronouns (mă, te, se, ne, vă, se) before the verb: 'mă trezeam' = 'me despertaba'. The structure is the same — just swap the verb conjugation."
    }
  ],
  "pronunciation": [],
