    {
      "id": 2,
      "type": "fill-in-blank",
      "title": "Complete with trade vocabulary",
      "instructions": "Fill in the blanks with the correct trade term.",
      "items": [
        {
          "sentence": "La _____ mide la diferencia entre exportaciones e importaciones.",
          "answer": "balanza comercial",
          "hints": [
            "three words",
            "starts with b"
          ]
        },
        {
          "sentence": "El _____ es un impuesto sobre los productos importados.",
          "answer": "arancel",
          "hints": [
            "one word",
            "starts with a"
          ]
        },
        {
          "sentence": "El _____ facilita el comercio entre países miembros.",
          "answer": "tratado de libre comercio",
          "hints": [
            "five words",
            "starts with t"
          ]
        },
        {
          "sentence": "La _____ controla la cantidad de dinero en circulación.",
          "answer": "política monetaria",
          "hints": [
            "three words",
            "starts with p"
          ]
        },
        {
          "sentence": "La _____ es el precio de una moneda respecto a otra.",
          "answer": "tipo de cambio",
          "hints": [
            "four words",
            "starts with t"
          ]
        },
