  "grammar": [
    {
      "id": 1,
      "title": "Conditional Perfect for Economic Hypotheticals",
      "description": "Using conditional perfect to discuss what would have happened in economic scenarios.",
      "examples": [
        {
          "sentence": "Si no se hubiera aplicado la política monetaria, la crisis habría sido peor.",
          "translation": "If monetary policy had not been applied, the crisis would have been worse."
        },
        {
          "sentence": "Los países en desarrollo habrían crecido más si hubieran tenido mejor acceso al capital.",
          "translation": "Developing countries would have grown more if they had better access to capital."
        },
        {
          "sentence": "El comercio internacional habría disminuido si se hubieran impuesto más aranceles.",
          "translation": "International trade would have decreased if more tariffs had been imposed."
        },
        {
          "sentence": "La inflación habría sido controlada si el banco central hubiera actuado antes.",
          "translation": "Inflation would have been controlled if the central bank had acted earlier."
        }
      ]
    },
    {
      "id": 2,
      "title": "Subjunctive in Economic Predictions and Policy",
      "description": "Using the subjunctive after expressions of economic prediction and policy recommendation.",
      "examples": [
        {
          "sentence": "Es probable que el crecimiento económico disminuya el próximo año.",
          "translation": "It is likely that economic growth will decrease next year."
        },
        {
          "sentence": "Los economistas esperan que el gobierno implemente reformas fiscales.",
          "translation": "Economists expect the government to implement tax reforms."
        },
        {
          "sentence": "No es seguro que la deuda externa sea sostenible a largo plazo.",
          "translation": "It is not certain that external debt will be sustainable long-term."
        },
        {
          "sentence": "Es fundamental que se reduzca la desigualdad económica.",
          "translation": "It is essential that economic inequality be reduced."
        }
      ]
    },
    {
      "id": 3,
      "title": "Advanced Connectors for Trade Analysis",
      "description": "Complex connectors for structured economic and trade writing.",
      "examples": [
        {
          "sentence": "Si bien el libre comercio beneficia a las economías desarrolladas, no siempre favorece a las economías emergentes.",
          "translation": "While free trade benefits developed economies, it does not always favor emerging economies."
        },
        {
          "sentence": "Por un lado, la globalización ha generado crecimiento; por otro, ha aumentado la desigualdad.",
          "translation": "On one hand, globalization has generated growth; on the other, it has increased inequality."
        },
        {
          "sentence": "A pesar de los tratados de libre comercio, las barreras no arancelarias continúan existiendo.",
          "translation": "Despite free trade agreements, non-tariff barriers continue to exist."
        },
        {
          "sentence": "En consecuencia, la política comercial debe reequilibrarse.",
          "translation": "As a consequence, trade policy must be rebalanced."
        }
      ]
    }
  ],
