    {
      "id": 2,
      "type": "fill-in-blank",
      "title": "Complete with media vocabulary",
      "instructions": "Fill in the blanks with the correct media term.",
      "items": [
        {
          "sentence": "La _____ es la publicación falsa que se difunde como información real.",
          "answer": "desinformación",
          "hints": [
            "one word",
            "starts with d"
          ]
        },
        {
          "sentence": "La _____ protege el derecho de los medios a publicar sin interferencia.",
          "answer": "libertad de prensa",
          "hints": [
            "three words",
            "starts with l"
          ]
        },
        {
          "sentence": "La _____ es el control gubernamental sobre los medios de comunicación.",
          "answer": "censura",
          "hints": [
            "one word",
            "starts with c"
          ]
        },
        {
          "sentence": "El _____ es un artículo de opinión en un periódico.",
          "answer": "editorial",
          "hints": [
            "one word",
            "starts with e"
          ]
        },
        {
          "sentence": "La _____ ocurre cuando los algoritmos muestran solo contenido que confirma nuestras creencias.",
          "answer": "burbuja de filtros",
          "hints": [
            "three words",
            "starts with b"
          ]
        },
        {
          "sentence": "La _____ es el concepto donde las emociones importan más que los hechos.",
          "answer": "posverdad",
          "hints": [
            "one word",
            "starts with p"
          ]
        },
        {
          "sentence": "El _____ es el proceso de verificar la veracidad de una noticia.",
          "answer": "fact-checking",
          "hints": [
            "one word",
            "starts with f"
          ]
        },
        {
          "sentence": "La _____ es cuando un gobierno prohíbe publicar cierta información.",
          "answer": "censura",
