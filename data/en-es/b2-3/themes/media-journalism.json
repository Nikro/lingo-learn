  "grammar": [
    {
      "id": 1,
      "title": "Passive Voice and Se Pasiva in Media Context",
      "description": "Using passive and se pasiva for formal media reporting.",
      "examples": [
        {
          "sentence": "La noticia fue publicada por el diario más importante del país.",
          "translation": "The news was published by the country's most important newspaper."
        },
        {
          "sentence": "Se descubrió que los datos eran falsos.",
          "translation": "It was discovered that the data were false."
        },
        {
          "sentence": "El artículo fue censurado por el gobierno.",
          "translation": "The article was censored by the government."
        },
        {
          "sentence": "Se ha verificado la información de la fuente oficial.",
          "translation": "The information from the official source has been verified."
        }
      ]
    },
    {
      "id": 2,
      "title": "Subjunctive in Media Ethics and Reporting",
      "description": "Using the subjunctive for reporting uncertain or debated media topics.",
      "examples": [
        {
          "sentence": "Es dudoso que la red social proteja la privacidad de los usuarios.",
          "translation": "It is doubtful that the social media protects user privacy."
        },
        {
          "sentence": "Los periodistas exigen que se respete la libertad de prensa.",
          "translation": "Journalists demand that press freedom be respected."
        },
        {
          "sentence": "No es cierto que la noticia sea veraz.",
          "translation": "It is not true that the news is truthful."
        },
        {
          "sentence": "Es posible que la desinformación afecte las elecciones.",
          "translation": "It is possible that disinformation will affect the elections."
        }
      ]
    },
    {
      "id": 3,
      "title": "Connectors for Editorial Analysis",
      "description": "Advanced connectors for analyzing and critiquing media content.",
      "examples": [
        {
          "sentence": "Si bien la prensa es libre, también es responsable de la veracidad de los hechos.",
          "translation": "While the press is free, it is also responsible for the truthfulness of facts."
        },
        {
          "sentence": "Por un lado, las redes sociales democratizan la información; por otro, facilitan la desinformación.",
          "translation": "On one hand, social media democratizes information; on the other, it facilitates disinformation."
        },
        {
          "sentence": "Aunque se ha avanzado en transparencia, la rendición de cuentas sigue siendo insuficiente.",
          "translation": "Although progress has been made in transparency, accountability remains insufficient."
        },
        {
          "sentence": "Por lo tanto, es necesario fortalecer las instituciones periodísticas.",
          "translation": "Therefore, it is necessary to strengthen journalistic institutions."
        }
      ]
    }
  ],
