    {
      "id": 2,
      "type": "fill-in-blank",
      "title": "Complete with literary vocabulary",
      "instructions": "Fill in the blanks with the correct term.",
      "items": [
        {
          "sentence": "La _____ examina las obras literarias desde diferentes enfoques teóricos.",
          "answer": "crítica literaria",
          "hints": [
            "two words",
            "starts with c"
          ]
        },
        {
          "sentence": "El _____ combina elementos reales con elementos fantásticos.",
          "answer": "realismo mágico",
          "hints": [
            "two words",
            "starts with r"
          ]
        },
        {
          "sentence": "El narrador _____ conoce todos los pensamientos de todos los personajes.",
          "answer": "omnisciente",
          "hints": [
            "one word",
            "starts with o"
          ]
        },
        {
          "sentence": "La _____ es una comparación implícita entre dos cosas distintas.",
          "answer": "metáfora",
          "hints": [
            "one word",
            "starts with m"
          ]
        },
        {
          "sentence": "La _____ es una narrativa con un significado oculto o simbólico.",
          "answer": "alegoría",
          "hints": [
            "one word",
            "starts with a"
          ]
        },
        {
          "sentence": "El _____ es un discurso que un personaje se dirige a sí mismo en el escenario.",
          "answer": "soliloquio",
          "hints": [
            "one word",
            "starts with s"
          ]
        },
        {
          "sentence": "La _____ consiste en analizar textos revelando sus contradicciones.",
          "answer": "deconstrucción",
          "hints": [
            "one word",
            "starts with d"
