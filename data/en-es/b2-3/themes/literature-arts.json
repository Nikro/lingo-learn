  "grammar": [
    {
      "id": 1,
      "title": "Complex Relative Clauses for Literary Analysis",
      "description": "Using whose, whom, wherein, whereby for sophisticated analysis.",
      "examples": [
        {
          "sentence": "El autor, cuyo estilo influyó en toda una generación, murió joven.",
          "translation": "The author, whose style influenced an entire generation, died young."
        },
        {
          "sentence": "La obra, en la que se exploran temas existenciales, es fundamental.",
          "translation": "The work, in which existential themes are explored, is fundamental."
        },
        {
          "sentence": "El personaje, a quien el narrador presenta como héroe, resulta ser trágico.",
          "translation": "The character, whom the narrator presents as a hero, turns out to be tragic."
        },
        {
          "sentence": "La novela, mediante la cual el autor critica la sociedad, es una obra maestra.",
          "translation": "The novel, through which the author critiques society, is a masterpiece."
        }
      ]
    },
    {
      "id": 2,
      "title": "Subjunctive for Artistic Evaluation and Judgment",
      "description": "Using subjunctive after expressions of artistic evaluation.",
      "examples": [
        {
          "sentence": "Es necesario que se reconozca el valor del arte contemporáneo.",
          "translation": "It is necessary that contemporary art's value be recognized."
        },
        {
          "sentence": "No creo que la obra cumpla con las expectativas del público.",
          "translation": "I don't think the work meets the public's expectations."
        },
        {
          "sentence": "Es sorprendente que un artista pueda expresar tanto con tan poco.",
          "translation": "It is surprising that an artist can express so much with so little."
        },
        {
          "sentence": "Dudo que el arte digital reemplace el arte tradicional.",
          "translation": "I doubt that digital art will replace traditional art."
        }
      ]
    },
    {
      "id": 3,
      "title": "Connectors for Literary Criticism",
      "description": "Advanced connectors for structured literary and artistic analysis.",
      "examples": [
        {
          "sentence": "Si bien la obra posee virtudes estilísticas, adolece de coherencia narrativa.",
          "translation": "While the work possesses stylistic virtues, it lacks narrative coherence."
        },
        {
          "sentence": "Por un lado, el simbolismo enriquece la lectura; por otro, puede dificultar la comprensión.",
          "translation": "On one hand, symbolism enriches the reading; on the other, it can hinder understanding."
        },
        {
          "sentence": "A pesar de la complejidad del texto, su mensaje es universal.",
          "translation": "Despite the text's complexity, its message is universal."
        },
        {
          "sentence": "Por consiguiente, la obra merece ser estudiada desde múltiples perspectivas.",
          "translation": "Consequently, the work deserves to be studied from multiple perspectives."
        }
      ]
    }
  ],
