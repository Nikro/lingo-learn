  "exercises": [
    {
      "type": "exercise",
      "question": "What preposition follows 'pensar' when meaning 'to think about'?",
      "options": [
        "de",
        "en",
        "a",
        "con"
      ],
      "correct": 1,
      "explanation": "'Pensar en' means 'to think about.' 'Pienso en ti' = I think about you."
    },
    {
      "type": "exercise",
      "question": "What does 'salir con' mean?",
      "options": [
        "to leave with",
        "to go out with / date",
        "to go out to",
        "to go out of"
      ],
      "correct": 1,
      "explanation": "'Salir con' means 'to go out with' or 'to date.' 'Ella sale con un chico' = She is dating a guy."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'Siempre pienso ____ mis vacaciones.' (I always think about my vacation.)",
      "correct": "en",
      "explanation": "'Pienso en' — pensar requires the preposition 'en' when meaning 'to think about.'"
    },
    {
      "type": "exercise",
      "question": "What does 'acabar de + infinitive' mean?",
      "options": [
        "to end to",
        "to have just done something",
        "to start to",
        "to forget to"
      ],
      "correct": 1,
      "explanation": "'Acabar de + infinitive' means 'to have just done something': Acabo de llegar = I just arrived."
    },
    {
      "type": "exercise",
      "question": "Which verb requires the preposition 'de' after it?",
      "options": [
        "pensar",
        "salir",
        "depender",
        "soñar"
      ],
      "correct": 2,
      "explanation": "'Depender de' = to depend on. 'Depende de ti' = It depends on you."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'Empieza ____ llover.' (It starts to rain.)",
      "correct": "a",
      "explanation": "'Empieza a llover' — empezar requires the preposition 'a' before another verb."
    }
