{
  "stage_id": "b1-1",
  "title": "B1.1 — Advanced Subjunctive, Passives, & Complex Narratives",
  "description": "Master the imperfect subjunctive, passive constructions, relative pronouns, and advanced connectors. Transition from basic narratives to complex, nuanced Spanish.",
  "themes": [
    {
      "id": "abstract-thinking-opinions",
      "title": "Abstract Thinking & Opinions",
      "description": "Express opinions, hypotheses, and thoughts on abstract concepts. Discuss ideas beyond the concrete and immediate, using the subjunctive to express doubt, possibility, and subjectivity. Master connectors for argumentation and vocabulary for abstract thinking — a hallmark of B1 competence."
    },
    {
      "id": "advanced-connectors",
      "title": "Advanced Connectors (Conectores Avanzados)",
      "description": "Master discourse markers for contrast, cause, addition, clarification, and conclusion."
    },
    {
      "id": "complex-travel-navigation",
      "title": "Complex Travel & Navigation",
      "description": "Navigate complex travel situations: extended journeys, cultural immersion, and problem-solving on the go. Master vocabulary for transportation, accommodations, directions, emergencies, and cultural interactions. Develop the ability to describe travel experiences in detail and handle real-world travel scenarios in Spanish."
    },
    {
      "id": "imperfect-subjunctive",
      "title": "Imperfect Subjunctive (Pretérito Imperfecto de Subjuntivo)",
      "description": "Express hypothetical actions, wishes, or conditions in the past using the imperfect subjunctive (-ra/-se forms)."
    },
    {
      "id": "literature-arts",
      "title": "Literature & Arts",
      "description": "Vocabulary, grammar, pronunciation, and exercises focused on literary analysis, art criticism, cultural movements, and creative expression at the B1.1 CEFR level."
    },
    {
      "id": "passive-voice",
      "title": "Passive Voice (Voz Pasiva: Ser + Participio)",
      "description": "Learn the formal passive voice using ser + past participle, with agreement in gender and number."
    },
    {
      "id": "professional-communication",
      "title": "Professional Communication",
      "description": "Master the language of business and professional settings. Build vocabulary and grammar skills for meetings, presentations, emails, negotiations, and general business communication in Spanish. Develop the ability to participate in workplace interactions, convey ideas clearly, and handle professional situations with confidence."
    },
    {
      "id": "relative-pronouns",
      "title": "Relative Pronouns (Pronombres Relativos)",
      "description": "Master the full range of relative pronouns: que, el cual, cuyo, donde, lo que/lo cual."
    },
    {
      "id": "se-passive",
      "title": "Se Passive (Pasiva Refleja)",
      "description": "The most common way to express passive ideas in everyday Spanish — use 'se' + verb + subject."
    },
    {
      "id": "subjunctive-vs-indicative",
      "title": "Subjunctive vs. Indicative in Complex Clauses",
      "description": "Understand when subordinate clauses require the subjunctive vs. indicative based on the main clause verb."
    }
  ],
