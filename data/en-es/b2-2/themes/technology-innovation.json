  "grammar": [
    {
      "id": 1,
      "title": "Comparatives and Superlatives for Technology",
      "description": "Comparing technological innovations and their impact.",
      "examples": [
        {
          "sentence": "La inteligencia artificial es más avanzada que hace diez años.",
          "translation": "Artificial intelligence is more advanced than it was ten years ago."
        },
        {
          "sentence": "El internet de las cosas es la tecnología más disruptiva del siglo XXI.",
          "translation": "The Internet of Things is the most disruptive technology of the 21st century."
        },
        {
          "sentence": "Los smartphones son tan importantes como las herramientas de trabajo.",
          "translation": "Smartphones are as important as work tools."
        },
        {
          "sentence": "Esta aplicación es menos eficiente que la versión anterior.",
          "translation": "This app is less efficient than the previous version."
        }
      ]
    },
    {
      "id": 2,
      "title": "Subjunctive for Technological Possibilities",
      "description": "Using the subjunctive to express doubt about technological developments.",
      "examples": [
        {
          "sentence": "Es posible que la inteligencia artificial reemplace muchos trabajos.",
          "translation": "It is possible that AI will replace many jobs."
        },
        {
          "sentence": "No creo que el big data proteja adecuadamente la privacidad.",
          "translation": "I don't think big data adequately protects privacy."
        },
        {
          "sentence": "Es necesario que los gobiernos regulen las redes sociales.",
          "translation": "It is necessary that governments regulate social media."
        },
        {
          "sentence": "Dudo que la realidad virtual se convierta en la norma.",
          "translation": "I doubt that virtual reality will become the norm."
        }
      ]
    },
    {
      "id": 3,
      "title": "Formal Connectors for Technical Discussion",
      "description": "Connectors used in technical writing and presentations about technology.",
      "examples": [
        {
          "sentence": "En primer lugar, debemos considerar el impacto de la automatización.",
          "translation": "First, we must consider the impact of automation."
        },
        {
          "sentence": "Por un lado, la tecnología mejora la vida; por otro lado, crea dependencias.",
          "translation": "On one hand, technology improves life; on the other, it creates dependencies."
        },
        {
          "sentence": "En consecuencia, las empresas deben invertir en ciberseguridad.",
          "translation": "As a consequence, companies must invest in cybersecurity."
        },
        {
          "sentence": "Por el contrario, algunos argumentan que la tecnología nos aísla.",
          "translation": "On the contrary, some argue that technology isolates us."
        }
      ]
    }
  ],
