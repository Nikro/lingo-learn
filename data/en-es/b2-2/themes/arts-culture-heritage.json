  "grammar": [
    {
      "id": 1,
      "title": "Relative Clauses for Describing Art and Heritage",
      "description": "Using qui, que, donde, cuyo/cuya for cultural descriptions.",
      "examples": [
        {
          "sentence": "El museo, que fue construido en el siglo XIX, alberga más de mil obras.",
          "translation": "The museum, which was built in the 19th century, houses more than a thousand works."
        },
        {
          "sentence": "La escultura, cuya autoría se desconoce, es de gran valor.",
          "translation": "The sculpture, whose authorship is unknown, is of great value."
        },
        {
          "sentence": "La ciudad donde nació el artista es un sitio turístico.",
          "translation": "The city where the artist was born is a tourist site."
        },
        {
          "sentence": "El cuadro que compró la galería es una obra maestra.",
          "translation": "The painting that the gallery bought is a masterpiece."
        }
      ]
    },
    {
      "id": 2,
      "title": "Subjunctive for Cultural Opinions and Values",
      "description": "Using the subjunctive after expressions of opinion, value judgment, and doubt about culture.",
      "examples": [
        {
          "sentence": "Es importante que se conserven los monumentos históricos.",
          "translation": "It is important that historical monuments are preserved."
        },
        {
          "sentence": "No creo que el turismo de masas beneficie al patrimonio cultural.",
          "translation": "I don't think mass tourism benefits cultural heritage."
        },
        {
          "sentence": "Es lamentable que muchas tradiciones se pierdan.",
          "translation": "It is regrettable that many traditions are lost."
        },
        {
          "sentence": "Es posible que el gobierno invierta más en cultura.",
          "translation": "It is possible that the government will invest more in culture."
        }
      ]
    },
    {
      "id": 3,
      "title": "Formal Connectors for Cultural Analysis",
      "description": "Connectors for structured cultural writing.",
      "examples": [
        {
          "sentence": "En primer lugar, es necesario definir qué es el patrimonio cultural.",
          "translation": "First, it is necessary to define what cultural heritage is."
        },
        {
          "sentence": "Por consiguiente, la preservación del patrimonio requiere acción.",
          "translation": "Consequently, heritage preservation requires action."
        },
        {
          "sentence": "A pesar de los esfuerzos, la destrucción del patrimonio continúa.",
          "translation": "Despite efforts, heritage destruction continues."
        },
        {
          "sentence": "En resumen, la cultura es fundamental para la identidad nacional.",
          "translation": "In summary, culture is fundamental for national identity."
        }
      ]
    }
  ],
