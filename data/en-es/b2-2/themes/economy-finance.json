      "type": "fill-in-blank",
      "title": "Complete with financial vocabulary",
      "instructions": "Fill in the blanks with the correct financial term.",
      "items": [
        {
          "sentence": "La _____ es el aumento generalizado de precios en una economía.",
          "answer": "inflación",
          "hints": [
            "one word",
            "starts with i"
          ]
        },
        {
          "sentence": "Cuando hay _____, muchas personas no tienen trabajo.",
          "answer": "desempleo",
          "hints": [
            "one word",
            "starts with d"
          ]
        },
        {
          "sentence": "El _____ mide el valor total de bienes y servicios producidos.",
          "answer": "PIB",
          "hints": [
            "abbreviation",
            "three letters"
          ]
        },
        {
          "sentence": "Poner dinero en el banco para el futuro es un _____.",
          "answer": "ahorro",
          "hints": [
            "one word",
            "starts with a"
          ]
        },
        {
          "sentence": "Cuando los gastos superan los ingresos, hay un _____.",
          "answer": "déficit",
          "hints": [
            "one word",
            "starts with d"
          ]
        },
        {
          "sentence": "Una _____ permite comprar una casa pagando a lo largo de años.",
          "answer": "hipoteca",
          "hints": [
            "one word",
            "starts with h"
          ]
        },
        {
          "sentence": "El _____ es el dinero que ganas por trabajar.",
          "answer": "salario",
          "hints": [
            "one word",
            "starts with s"
          ]
        },
        {
          "sentence": "Comprar _____ es comprar una parte de una empresa.",
          "answer": "acción",
          "hints": [
            "one word",
            "starts with a"
          ]
        },
        {
          "sentence": "La _____ fiscal es ilegal y puede tener consecuencias penales.",
          "answer": "evasión",
          "hints": [
            "one word",
            "starts with e"
          ]
        },
        {
          "sentence": "El _____ comercial mide la diferencia entre exportaciones e importaciones.",
          "answer": "déficit",
