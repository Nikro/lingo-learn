  "grammar": [
    {
      "id": 1,
      "title": "Conditional for Economic Scenarios",
      "description": "Using the conditional to discuss hypothetical economic situations.",
      "examples": [
        {
          "sentence": "Si los tipos de interés subieran, los préstamos serían más caros.",
          "translation": "If interest rates rose, loans would be more expensive."
        },
        {
          "sentence": "La inflación podría reducir el poder adquisitivo de los ciudadanos.",
          "translation": "Inflation could reduce citizens' purchasing power."
        },
        {
          "sentence": "Los inversores tendrían más beneficios si el mercado creciera.",
          "translation": "Investors would have more profit if the market grew."
        },
        {
          "sentence": "El desempleo disminuiría si se crearan más empresas.",
          "translation": "Unemployment would decrease if more companies were created."
        }
      ]
    },
    {
      "id": 2,
      "title": "Subjunctive for Financial Advice and Recommendations",
      "description": "Using the subjunctive after expressions of recommendation, necessity, and doubt in finance.",
      "examples": [
        {
          "sentence": "Es importante que ahorres para el futuro.",
          "translation": "It is important that you save for the future."
        },
        {
          "sentence": "Recomiendo que inviertas en fondos de índice.",
          "translation": "I recommend that you invest in index funds."
        },
        {
          "sentence": "No es aconsejable que gastes más de lo que ganas.",
          "translation": "It is not advisable to spend more than you earn."
        },
        {
          "sentence": "Dudo que la bolsa suba en el corto plazo.",
          "translation": "I doubt that the stock market will rise in the short term."
        }
      ]
    },
    {
      "id": 3,
      "title": "Formal Connectors for Economic Analysis",
      "description": "Connectors for structured economic and financial writing.",
      "examples": [
        {
          "sentence": "En primer lugar, es necesario analizar la situación macroeconómica.",
          "translation": "First, it is necessary to analyze the macroeconomic situation."
        },
        {
          "sentence": "Por otra parte, hay que considerar los indicadores del empleo.",
          "translation": "On the other hand, employment indicators must be considered."
        },
        {
          "sentence": "En consecuencia, la política monetaria debe ajustarse.",
          "translation": "As a consequence, monetary policy must be adjusted."
        },
        {
          "sentence": "A pesar de ello, el crecimiento económico continúa.",
          "translation": "Despite this, economic growth continues."
        }
      ]
    }
  ],
