{
  "stage_id": "b2-1",
  "title": "B2.1 — Hypotheticals & Professional Communication",
  "description": "Master Type 2 and Type 3 conditionals (hypotheticals in present and past), advanced gerund uses, object pronoun placement with non-finite verbs, and professional/business vocabulary.",
  "themes": [
    {
      "id": "advanced-creative-expression-part-1",
      "title": "Advanced Creative Expression",
      "description": "Vocabulary, grammar, and exercises for creative writing, artistic expression, storytelling, and narrative techniques at the B2.1 CEFR level."
    },
    {
      "id": "advanced-idioms",
      "title": "Advanced Idioms & Fixed Expressions",
      "description": "Learn B2-level idiomatic expressions for work, social situations, opinions, and daily life."
    },
    {
      "id": "advanced-literary-analysis-part-1",
      "title": ""
    },
    {
      "id": "advanced-professional-communication-part-1",
      "title": "Advanced Professional Communication",
      "description": "Vocabulary, grammar, and exercises for executive communication, strategic messaging, and stakeholder presentations at the B2.1 CEFR level."
    },
    {
      "id": "civic-engagement-public-policy-part-1",
      "title": "Civic Engagement & Public Policy",
      "description": "Vocabulary, grammar, and exercises for discussing civic participation, public policy debate, governance, and community engagement at the B2.1 CEFR level."
    },
    {
      "id": "critical-thinking-reasoning",
      "title": "Critical Thinking & Reasoning",
      "description": "Develop the ability to analyze arguments, construct logical reasoning, evaluate claims critically, and express nuanced opinions. Learn vocabulary and structures for logical reasoning, critical analysis, and advanced argumentation — essential for academic, professional, and intellectual discourse in Spanish."
    },
    {
      "id": "pronouns-gerundio-infinitivo",
      "title": "Object Pronouns with Gerundio and Infinitivo",
      "description": "Master pronoun placement and attachment rules with non-finite verb forms."
    },
    {
      "id": "type-3-conditionals",
      "title": "Type 3 Conditionals — Si + Pluperfect Subjunctive + Conditional Perfect",
      "description": "Express hypothetical situations in the past that did NOT happen — regrets, missed opportunities, and alternate histories."
    }
  ],
