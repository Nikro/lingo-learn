    {
      "type": "exercise",
      "question": "What does 'hace calor' mean?",
      "options": ["It's cold", "It's hot", "It's raining", "It's windy"],
      "correct": 1,
      "explanation": "'Hace calor' means 'It's hot' (literally: 'it makes heat'). For cold: 'hace frío'."
    },
    {
      "type": "exercise",
      "question": "What does 'hace frío' mean?",
      "options": ["It's hot", "It's windy", "It's cold", "It's cloudy"],
      "correct": 2,
      "explanation": "'Hace frío' means 'It's cold' (literally: 'it makes cold'). 'Hace calor' = it's hot."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'Yo ____ (tener) fiebre.' (I have a fever.)",
      "correct": "tengo",
      "explanation": "'Tengo fiebre' uses the irregular 'tengo' (yo form of tener). 'Tener' means 'to have.'"
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'Me duele la ____.' (My head hurts.)",
      "correct": "cabeza",
      "explanation": "'Me duele la cabeza' = 'I have a headache.' The verb 'doler' works like 'gustar' — it agrees with what hurts."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'Ayer ____ (llover) todo el día.' (Yesterday it rained all day.)",
      "correct": "llovió",
      "explanation": "'Llovió' is the él/ella/usted preterite form of llover. It's a stem-changing verb (o→ue) in the preterite."
    }
