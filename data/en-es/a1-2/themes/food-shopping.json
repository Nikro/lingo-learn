    {
      "type": "exercise",
      "question": "What does 'barato' mean?",
      "options": ["Expensive", "Cheap", "Delicious", "Fresh"],
      "correct": 1,
      "explanation": "'Barato' means cheap. 'Caro' means expensive. 'Este producto es muy barato' (This product is very cheap)."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: '¿______ cuesta esto?' (How much does this cost?)",
      "correct": "Cuánto",
      "explanation": "'¿Cuánto cuesta?' is the standard way to ask for the price. The accent on 'Cuánto' is mandatory."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'La ______, por favor.' (The bill, please.)",
      "correct": "cuenta",
      "explanation": "'La cuenta, por favor' is how you ask for the bill at a restaurant. 'Cuenta' is a feminine noun."
    },
    {
      "type": "exercise",
      "question": "What does 'caro' mean?",
      "options": ["Cheap", "Beautiful", "Expensive", "Small"],
      "correct": 2,
      "explanation": "'Caro' means expensive. 'Barato' means cheap. Remember: 'Ese vestido es muy caro' (That dress is very expensive)."
    },
    {
      "type": "fill-in-blank",
      "question": "Complete: 'Yo ______ la compra todos los sábados.' (I do the shopping every Saturday.)",
      "correct": "hago",
      "explanation": "'Hacer la compra' is the common expression for grocery shopping. It's an irregular verb: yo hago."
