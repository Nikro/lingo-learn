{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spanish Learning App — Stage Data Schema",
  "description": "Schema for stage-level curriculum content. Each JSON file in data/{locale}/ represents one stage (e.g., a1-1.json = A1.1).\n\nRoot stage files are manifests (metadata + theme list). Theme files under data/{locale}/{stage}/themes/ contain full content (vocabulary, grammar, exercises).",
  "type": "object",
  "required": ["title"],
  "properties": {
    "file_type": {
      "type": "string",
      "enum": ["manifest", "content"],
      "description": "Discriminator: 'manifest' for stage summary files (metadata + theme list only), 'content' for theme files with full curriculum content. Auto-detected if omitted."
    },
    "id": {
      "type": "string",
      "description": "Stage/theme identifier in kebab-case. Alias: stage_id",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "stage_id": {
      "type": "string",
      "description": "Stage/theme identifier in kebab-case: a1-1, a1-2, b1-3, etc.",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "description": "Display title"
    },
    "description": {
      "type": "string",
      "description": "Brief description"
    },
    "estimated_weeks": {
      "type": "integer",
      "description": "Estimated weeks to complete this stage (manifest only)"
    },
    "themes": {
      "type": "array",
      "description": "List of theme summaries within this stage (manifest only)",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "description": "Theme identifier" },
          "title": { "type": "string", "description": "Theme title" },
          "description": { "type": "string", "description": "Theme description" },
          "estimated_hours": { "type": "integer", "description": "Estimated hours to complete this theme" },
          "sections": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Content sections: vocabulary, grammar, exercises, pronunciation"
          }
        }
      }
    },
    "grammar": {
      "type": "array",
      "description": "Grammar lessons for this stage",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "description": "Lesson title" },
          "content": { "type": "string", "description": "Explanation text" },
          "table": {
            "type": "object",
            "required": ["headers", "rows"],
            "properties": {
              "headers": { "type": "array", "items": { "type": "string" } },
              "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
            }
          },
          "examples": {
            "type": "array",
            "items": { "type": "string" }
          },
          "aid_note": {
            "type": "string",
            "description": "Language-aid hint for learners (e.g. comparing to Romanian/Italian)"
          }
        }
      }
    },
    "vocabulary": {
      "type": "array",
      "description": "Vocabulary items for this stage",
      "items": {
        "type": "object",
        "required": ["id", "target", "source"],
        "properties": {
          "id": { "type": "integer", "description": "Unique identifier" },
          "target": { "type": "string", "description": "Target language word/phrase" },
          "source": { "type": "string", "description": "Source language translation" },
          "gender": {
            "type": "string",
            "description": "Grammatical gender marker: 'm.', 'f.', '—' if not applicable"
          },
          "type": {
            "type": "string",
            "enum": ["greeting", "polite", "intro", "feeling", "noun", "adjective", "verb", "adverb", "preposition", "number", "family", "color", "connector", "phrase", "idiom", "other"],
            "description": "Semantic category of the word"
          },
          "aid_note": {
            "type": "string",
            "description": "Language-aid hint for learners (e.g. comparing to Romanian/Italian). Used only when content explicitly provides it."
          }
        }
      }
    },
    "verbs": {
      "type": "array",
      "description": "Verb entries with conjugation tables",
      "items": {
        "type": "object",
        "required": ["infinitive", "translation"],
        "properties": {
          "infinitive": { "type": "string", "description": "Verb in infinitive form" },
          "translation": { "type": "string", "description": "English translation" },
          "conjugations": {
            "type": "object",
            "description": "Map of tense names to conjugation maps. Optional — not all stages include full conjugation tables.",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "yo": { "type": "string" },
                "tú": { "type": "string" },
                "el/ella/usted": { "type": "string" },
                "nosotros": { "type": "string" },
                "vosotros": { "type": "string" },
                "ellos/ellas/ustedes": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "pronunciation": {
      "type": "array",
      "description": "Pronunciation lessons",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "description": "Lesson title" },
          "content": { "type": "string", "description": "Explanation text" },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "source"],
              "properties": {
                "target": { "type": "string", "description": "Sound/letter/phoneme" },
                "source": { "type": "string", "description": "English equivalent or example" }
              }
            }
          }
        }
      }
    },
    "exercises": {
      "type": "array",
      "description": "Interactive exercises",
      "items": {
        "type": "object",
        "required": ["type", "question", "explanation"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["exercise", "fill-in-blank", "conjugation", "conjugation-matrix", "drag-drop", "matching"],
            "description": "Exercise type: 'exercise' for multiple-choice, others for specific types"
          },
          "question": { "type": "string", "description": "The question or prompt" },
          "correct": {
            "description": "Correct answer — index for multiple-choice, string for fill-in-blank/conjugation"
          },
          "explanation": { "type": "string", "description": "Explanation shown after answering" },
          "options": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Multiple-choice options (only for type 'exercise')"
          },
          "pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "source"],
              "properties": {
                "target": { "type": "string" },
                "source": { "type": "string" }
              }
            },
            "description": "Matching pairs (only for type 'matching')"
          },
          "aid_note": {
            "type": "string",
            "description": "Language-aid hint for learners (e.g. comparing to Romanian/Italian)"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "conjugationTable": {
      "type": "object",
      "properties": {
        "yo": { "type": "string" },
        "tú": { "type": "string" },
        "él/ella/usted": { "type": "string" },
        "nosotros": { "type": "string" },
        "vosotros": { "type": "string" },
        "ellos/ellas/ustedes": { "type": "string" }
      }
    },
    "stage_manifest": {
      "type": "object",
      "description": "Root stage file — contains metadata and theme list only, NOT content.",
      "required": ["stage_id", "title"],
      "properties": {
        "stage_id": {
          "type": "string",
          "description": "Stage identifier in kebab-case: a1-1, a1-2, b1-3, etc.",
          "pattern": "^[a-z]\\d-\\d+$"
        },
        "id": {
          "type": "string",
          "description": "Alias for stage_id (some files use 'id' instead of 'stage_id')"
        },
        "title": {
          "type": "string",
          "description": "Display title, e.g. 'Stage A1.1 — Greetings & Introductions'"
        },
        "description": {
          "type": "string",
          "description": "Brief description of what the stage covers"
        },
        "estimated_weeks": {
          "type": "integer",
          "description": "Estimated weeks to complete this stage"
        },
        "themes": {
          "type": "array",
          "description": "List of theme summaries within this stage",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "estimated_hours": { "type": "integer" }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
